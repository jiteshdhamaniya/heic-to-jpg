{
  "name": "heic-to-jpg",
  "version": "1.1.0",
  "description": "HEIC to JPG Converter",
  "main": "index.js",
  "author": {
    "name": "Jitesh Dhamaniya"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node --check index.js && node --check preload.js && node --check renderer.js && node --check conversion.js",
    "build": "electron-builder --mac --publish never",
    "build:dir": "electron-builder --mac --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "heic-convert": "2.1.0"
  },
  "build": {
    "appId": "com.yourdomain.heictojpg",
    "productName": "HEIC to JPG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "conversion.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "target": "dmg",
      "icon": "icon.icns",
      "category": "public.app-category.photography",
      "identity": null,
      "minimumSystemVersion": "13.0"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jiteshdhamaniya/heic-to-jpg.git"
  }
}
